#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyjwt[crypto]", "requests"]
# ///
"""Print a short-lived (1 hour) GitHub App installation token for the agent.

Use it only for the GitHub actions the agent should do as the bot:
    GH_TOKEN=$(mint-agent-token) gh issue create -R BrainCOGS/U19-pipeline-python ...
    GH_TOKEN=$(mint-agent-token) gh pr create    -R BrainCOGS/U19-pipeline-python ...
git push and commits keep using your own credentials and identity.

Configuration (environment variables):
    AGENT_APP_ID   the App ID from the app's settings page (not secret), default
                   5337299 (braincogs-claude-agent). Agent shells don't read
                   ~/.bashrc, so the default saves exporting it everywhere.
    AGENT_APP_KEY  path to the app's private key, default ~/.config/braincogs-agent/agent.pem
    AGENT_APP_ORG  the org the app is installed on, default BrainCOGS
"""

import os
import time

import jwt
import requests

API = "https://api.github.com"


def main() -> None:
    app_id = os.environ.get("AGENT_APP_ID", "5337299")
    key_path = os.path.expanduser(
        os.environ.get("AGENT_APP_KEY", "~/.config/braincogs-agent/agent.pem")
    )
    org = os.environ.get("AGENT_APP_ORG", "BrainCOGS")

    with open(key_path) as f:
        private_key = f.read()

    # 1. A JWT signed with the private key proves "I am the app" (valid < 10 min).
    now = int(time.time())
    app_jwt = jwt.encode(
        {"iat": now - 60, "exp": now + 540, "iss": app_id},
        private_key,
        algorithm="RS256",
    )
    headers = {
        "Authorization": f"Bearer {app_jwt}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    }

    # 2. Find the app's installation on the org.
    resp = requests.get(f"{API}/orgs/{org}/installation", headers=headers, timeout=30)
    resp.raise_for_status()
    installation_id = resp.json()["id"]

    # 3. Exchange the JWT for an installation token (expires after 1 hour,
    #    limited to the repos and permissions the installation grants).
    resp = requests.post(
        f"{API}/app/installations/{installation_id}/access_tokens",
        headers=headers,
        timeout=30,
    )
    resp.raise_for_status()
    print(resp.json()["token"])


if __name__ == "__main__":
    main()
